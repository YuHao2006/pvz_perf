atlas(vase_shards particle:VaseShatter particle:VaseShatterLeaf particle:VaseShatterZombie)
atlas(award_rays particle:Award particle:CreditsRaysWipe)
atlas(fireball_burst particle:FireballDeath particle:ZombieBossFireball)
atlas(pool_splash particle:PlantingPool particle:PoolSplash)
atlas(zombie_heads particle:MoweredZombieHead particle:ZombieHead particle:ZombieHeadPool)
atlas(pickup_starburst particle:PresentPickup particle:Starburst)
atlas(projectile_splat particle:CabbageSplat particle:PeaSplat)
atlas(dust particle:DustFoot particle:DustSquash)
atlas(ice_trail particle:BossIceBallTrail particle:IceBallDeath particle:SnowPeaTrail)
atlas(pickup_arrows particle:CoinPickupArrow particle:SeedPacketPick particle:UpsellArrow)
atlas(zombie_arms particle:MoweredZombieArm particle:ZombieArm)
atlas(sparkles particle:IceSparkle particle:TrophySparkle)
