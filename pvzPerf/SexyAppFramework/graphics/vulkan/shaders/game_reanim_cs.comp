#version 450
// One invocation evaluates a logical track and writes its complete triangle
// list. Scalar layouts deliberately match the existing 40-byte GpuVertex.
layout(local_size_x=64) in;
struct Track { uint keyOffset, keyCount, flags, padding; };
struct Key {
    float transX, transY, skewX, skewY, scaleX, scaleY, alpha;
    int frame;
    uint imageSlot, padding0, padding1, padding2;
};
struct Geometry {
    float width, height, u0, v0, u1, v1;
    uint padding0, padding1;
};
struct Job {
    uvec4 sampleInfo;
    vec4 timeTranslation;
    vec4 overlayX;
    vec4 overlayY;
    uvec4 colorFlags;
    uvec4 outputInfo;
    vec4 clip;
};
layout(set=0,binding=0,std430) readonly buffer Tracks { Track tracks[]; };
layout(set=0,binding=1,std430) readonly buffer Keys { Key keys[]; };
layout(set=0,binding=2,std430) readonly buffer Geometries { Geometry geometry[]; };
layout(set=0,binding=3,std430) readonly buffer Jobs { Job jobs[]; };
layout(set=0,binding=4,std430) writeonly buffer Vertices { uint words[]; };
layout(push_constant) uniform Push { uint firstJob, jobCount; } push;

float interpolate(float a,float b,float t) {
    precise float value=a+(b-a)*t;
    return value;
}
float fastSin(float radians) {
    precise float t=radians*0.15915494+0.5;
    t-=floor(t);
    precise float x=(t-0.5)*6.2831853;
    precise float x2=x*x;
    precise float result=x*(0.999999707+x2*(-0.166665772+x2*(0.008332558+
        x2*(-0.000198125755+x2*(2.70405121e-06+x2*-2.05342445e-08)))));
    return result;
}
float fastCos(float radians) {
    precise float angle=radians+1.57079633;
    return fastSin(angle);
}
void storeVertex(uint index,vec4 point,vec4 color,uint slot,uint samplerIndex) {
    uint base=index*10u;
    words[base]=floatBitsToUint(point.x); words[base+1u]=floatBitsToUint(point.y);
    words[base+2u]=floatBitsToUint(color.r); words[base+3u]=floatBitsToUint(color.g);
    words[base+4u]=floatBitsToUint(color.b); words[base+5u]=floatBitsToUint(color.a);
    words[base+6u]=floatBitsToUint(point.z); words[base+7u]=floatBitsToUint(point.w);
    words[base+8u]=slot; words[base+9u]=samplerIndex;
}
bool insideClip(vec4 vertex,int edge,float boundary) {
    float value=(edge==0 || edge==2)?vertex.x:vertex.y;
    return edge<2?value>=boundary:value<boundary;
}
vec4 intersection(vec4 a,vec4 b,int edge,float boundary) {
    float av=(edge==0 || edge==2)?a.x:a.y;
    float bv=(edge==0 || edge==2)?b.x:b.y;
    precise float t=(boundary-av)/(bv-av);
    precise vec4 result=a+(b-a)*t;
    return result;
}
void main() {
    uint local=gl_GlobalInvocationID.x;
    if (local>=push.jobCount) return;
    Job job=jobs[push.firstJob+local];
    Track track=tracks[job.sampleInfo.x];
    Key a=keys[track.keyOffset+job.sampleInfo.y];
    Key b=keys[track.keyOffset+job.sampleInfo.z];
    float t=job.timeTranslation.x;
    precise float alpha=interpolate(a.alpha,b.alpha,t);
    precise float byteAlpha=alpha*float((job.colorFlags.x>>24u)&255u);
    byteAlpha=clamp(trunc(byteAlpha>0.0?byteAlpha+0.5:byteAlpha-0.5),0.0,255.0);
    uint image=a.imageSlot;
    bool visible=a.frame>=0 && image!=0u && byteAlpha>0.0;
    if (job.colorFlags.w!=0u && a.frame!=-1 && b.frame==-1 && t>0.0) visible=false;
    Geometry base=geometry[image];
    Geometry source=geometry[job.sampleInfo.w*job.outputInfo.z+image];
    if (source.width<=0.0 || source.height<=0.0) visible=false;
    vec4 color=vec4(float((job.colorFlags.x>>16u)&255u),float((job.colorFlags.x>>8u)&255u),
        float(job.colorFlags.x&255u),byteAlpha)/255.0;
    vec4 polygon[8];
    int count=0;
    if (visible) {
        // Match MatrixFromTransform's unary negation and DEG_TO_RAD ordering.
        precise float skewX=-(interpolate(a.skewX,b.skewX,t)*0.017453292);
        precise float skewY=-(interpolate(a.skewY,b.skewY,t)*0.017453292);
        precise float sx=interpolate(a.scaleX,b.scaleX,t);
        precise float sy=interpolate(a.scaleY,b.scaleY,t);
        precise float m00=fastCos(skewX)*sx, m10=-fastSin(skewX)*sx;
        precise float m01=fastSin(skewY)*sy, m11=fastCos(skewY)*sy;
        precise float tx=interpolate(a.transX,b.transX,t);
        precise float ty=interpolate(a.transY,b.transY,t);
        precise float cx=m00*(base.width*0.5)+m01*(base.height*0.5)+tx;
        precise float cy=m10*(base.width*0.5)+m11*(base.height*0.5)+ty;
        precise float xx=job.overlayX.x*m00+job.overlayX.y*m10;
        precise float xy=job.overlayX.x*m01+job.overlayX.y*m11;
        precise float yx=job.overlayY.x*m00+job.overlayY.y*m10;
        precise float yy=job.overlayY.x*m01+job.overlayY.y*m11;
        precise float ox=job.overlayX.x*cx+job.overlayX.y*cy+job.overlayX.z;
        precise float oy=job.overlayY.x*cx+job.overlayY.y*cy+job.overlayY.z;
        ox+=job.timeTranslation.y; oy+=job.timeTranslation.z;
        vec2 corners[4]=vec2[4](vec2(-source.width/2.0,-source.height/2.0),
            vec2(-source.width/2.0,source.height/2.0),
            vec2(source.width/2.0,source.height/2.0),
            vec2(source.width/2.0,-source.height/2.0));
        vec2 uv[4]=vec2[4](vec2(source.u0,source.v0),vec2(source.u0,source.v1),
            vec2(source.u1,source.v1),vec2(source.u1,source.v0));
        for (int i=0;i<4;++i) {
            precise float x=xx*corners[i].x+xy*corners[i].y+ox;
            precise float y=yx*corners[i].x+yy*corners[i].y+oy;
            polygon[i]=vec4(x,y,uv[i]);
        }
        count=4;
        if (job.outputInfo.y==18u) {
            for (int edge=0;edge<4;++edge) {
                if (count<2) { count=0; break; }
                vec4 clipped[8]; int written=0;
                for (int i=0;i<count;++i) {
                    vec4 p=polygon[(i+count-1)%count], q=polygon[i];
                    bool pIn=insideClip(p,edge,job.clip[edge]);
                    bool qIn=insideClip(q,edge,job.clip[edge]);
                    if (pIn && qIn) clipped[written++]=q;
                    else if (pIn!=qIn) {
                        clipped[written++]=intersection(p,q,edge,job.clip[edge]);
                        if (qIn) clipped[written++]=q;
                    }
                }
                count=written;
                for (int i=0;i<count;++i) polygon[i]=clipped[i];
            }
        }
    }
    uint slot=job.outputInfo.w|job.colorFlags.y;
    // Fan order matches DrawPolyClipped. Null-clip draws retain the original
    // CPU strip's other diagonal and vertex order.
    for (uint triangle=0u;triangle<job.outputInfo.y/3u;++triangle) {
        bool emitted=count>=3 && int(triangle)<count-2;
        vec4 p=emitted?polygon[0]:vec4(0.0);
        vec4 q=emitted?polygon[triangle+1u]:p;
        vec4 r=emitted?polygon[triangle+2u]:p;
        if (emitted && job.outputInfo.y==6u) {
            p=polygon[triangle==0u?0:1];
            q=polygon[triangle==0u?1:3];
            r=polygon[triangle==0u?3:2];
        }
        uint outputVertex=job.outputInfo.x+triangle*3u;
        storeVertex(outputVertex,p,color,slot,job.colorFlags.z);
        storeVertex(outputVertex+1u,q,color,slot,job.colorFlags.z);
        storeVertex(outputVertex+2u,r,color,slot,job.colorFlags.z);
    }
}
